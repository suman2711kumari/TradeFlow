# Development configuration for the TradeFlow Node backend.
# Copy this file to backend/.env and replace the sample JWT secret.
MONGO_URL=mongodb://127.0.0.1:27017/tradeflow
JWT_SECRET=REPLACE_THIS_WITH_A_LONG_RANDOM_SECRET
ML_SERVICE_URL=http://127.0.0.1:8000
# Optional Gemini assistant. Leave blank if not using the assistant.
GEMINI_API_KEY=
# Set GEMINI_MODEL to a model your Gemini API key can access.
# GEMINI_MODEL=
